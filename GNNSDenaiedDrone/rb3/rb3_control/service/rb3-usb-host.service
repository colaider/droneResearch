[Unit]
# The RB3 Gen 2 USB-A ports sit behind a Renesas uPD720201 (PCIe xHCI) that needs
# /lib/firmware/renesas_usb_fw.mem uploaded at probe time. The PCI device is probed from
# initramfs, before the root filesystem (and therefore the firmware file) is available, so
# the probe always fails with -2 and the ports stay dead. Re-probing once userspace is up
# loads the firmware and brings up the hub, the Ethernet adapter and the flight controller.
# See rb3_control/docs/USB_SETUP.md
Description=Re-probe the Renesas USB 3.0 host controller (firmware is only readable after rootfs mount)
After=local-fs.target
ConditionPathExists=/lib/firmware/renesas_usb_fw.mem
ConditionPathExists=/sys/bus/pci/devices/0001:04:00.0

[Service]
Type=oneshot
RemainAfterExit=yes
# Harmless if the controller is already bound: the write then just fails quietly.
ExecStart=/bin/sh -c 'echo 0001:04:00.0 > /sys/bus/pci/drivers_probe || true'
ExecStartPost=/bin/sh -c 'for i in $(seq 1 20); do [ -e /dev/ttyACM0 ] && break; sleep 0.25; done; true'

[Install]
WantedBy=multi-user.target
