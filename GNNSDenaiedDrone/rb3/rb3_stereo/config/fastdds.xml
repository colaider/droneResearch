<?xml version="1.0" encoding="UTF-8"?>
<!-- Fast DDS profile for full-rate camera images on the drone itself.
     Default shared-memory segments are 512 KB: bigger messages (1280x800 = 1 MB per image) fall back
     to fragmented UDP, where best-effort delivery drops most of them. Larger segments keep every
     image in shared memory; UDP stays enabled for other machines (viewer, ground station).
     Used by run_stereo.sh; export FASTRTPS_DEFAULT_PROFILES_FILE=<this file> in other processes on the
     drone that subscribe to the raw images. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_large</transport_id>
      <type>SHM</type>
      <segment_size>33554432</segment_size>
      <maxMessageSize>8388608</maxMessageSize>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="rb3_stereo_participant" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>shm_large</transport_id>
        <transport_id>udp</transport_id>
      </userTransports>
    </rtps>
  </participant>
</profiles>
