#!/bin/bash
# Load the kernel side of the RB3 stereo camera (idempotent, run as root after every boot, or enable
# rb3-stereo-setup.service): patched qcom-camss in CSIPHY0 combo mode + CAM0B bring-up module.
# The modules are installed by drivers/install_board.sh.
set -e
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
modprobe i2c-dev

# Load camss with udev's exec queue held.
#
# camss registers its /dev/videoN nodes early and only finishes building the media graph in
# the async notifier's complete callback. udev reacts to each new node by running v4l_id,
# which opens it - and an open that lands in that window takes camss through
# video_open -> v4l2_pipeline_pm_get -> camss_find_sensor and dereferences NULL:
#
#   Unable to handle kernel NULL pointer dereference at virtual address 0000000000000030
#   CPU: 6 PID: 1389 Comm: v4l_id
#   camss_find_sensor+0x2c/0xa8 [qcom_camss]
#
# The module is then stuck in "Loading" forever, modprobe never returns (D state), no media
# device appears, and nothing can unload it - only a reboot clears it. Holding the exec queue
# defers v4l_id until modprobe has returned and the graph is complete. The trap matters: if
# this script dies with the queue stopped, every later udev event on the system stalls too.
udev_queue_release() {
  udevadm control --start-exec-queue 2>/dev/null || true
}

if [ "$(cat /sys/module/qcom_camss/parameters/combo_phy 2>/dev/null)" != 0 ]; then
  trap udev_queue_release EXIT
  udevadm control --stop-exec-queue 2>/dev/null || true
  rmmod qcom_camss 2>/dev/null || true
  modprobe qcom-camss combo_phy=0 combo_alias=1
  udev_queue_release
  trap - EXIT
  udevadm settle --timeout=10 2>/dev/null || true
fi
# Wait for camss to finish coming up before touching CAM0B.
#
# cam0b_bridge enables a camera clock whose parent belongs to camss, and inserting it right
# after camss has (re)loaded catches the clock before it is ready. The kernel then logs
#   WARNING: ... at drivers/clk/qcom/clk-branch.c:88 clk_branch_toggle   (status stuck)
# from cam0b_init, and modprobe fails with "Device or resource busy" - which is why the same
# script succeeds when run by hand a minute later. camss registers its media device only once
# its async notifier has completed, so that node appearing is the signal that it is ready.
camss_media_ready() {
  for node in /sys/class/media/media*; do
    [ -e "$node/device" ] || continue
    case "$(readlink -f "$node/device")" in *camss*) return 0 ;; esac
  done
  return 1
}

for _ in $(seq 1 50); do
  camss_media_ready && break
  sleep 0.2
done

if [ ! -d /sys/module/cam0b_bridge ]; then
  for attempt in 1 2 3 4 5; do
    modprobe cam0b_bridge && break
    [ "$attempt" = 5 ] && { echo "rb3-stereo-setup: cam0b_bridge would not insert" >&2; exit 1; }
    rmmod cam0b_bridge 2>/dev/null || true
    sleep 1
  done
fi
# frame-done interrupts of the two cameras on separate cores (both on CPU0 serializes them and
# skews the frame timestamps of the second camera by ~85 us) - little A55 cores 2 and 3, so the
# big A78 cores 4-7 stay free for the vision code
for n in 0 1; do
  irq=$(grep -m1 "camss_msm_vfe$n\$" /proc/interrupts | cut -d: -f1 | tr -d ' ')
  [ -n "$irq" ] && echo $((2 + n)) > "/proc/irq/$irq/smp_affinity_list"
done
if [ "$(cat /sys/module/qcom_camss/parameters/combo_phy 2>/dev/null)" != 0 ]; then
  echo "rb3-stereo-setup: the loaded qcom-camss has no combo mode - run drivers/install_board.sh" >&2
  exit 1
fi
echo "rb3-stereo-setup: camss combo mode on, CAM0B on $(ls /sys/bus/platform/devices/ac4b000.cci | grep -m1 -o 'i2c-[0-9]*')"
